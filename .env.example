# Browser-public configuration only. Copy to ignored .env.local for development.
# Never put an email API secret or Supabase service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
