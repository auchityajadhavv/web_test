# Server-side Supabase Edge Function secrets; enter through Supabase settings.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
# Never commit real values or copy these into the frontend environment.
DEMO_ALLOWED_ORIGINS=https://revora-live.vercel.app
TURNSTILE_HOSTNAMES=revora-live.vercel.app
TURNSTILE_SECRET_KEY=replace-in-supabase-settings
RESEND_API_KEY=replace-in-supabase-settings
# Company inbox supplied for demo notifications.
DEMO_TO_EMAIL=revora.org.com@gmail.com
# Must be a sender on a domain you own and have verified with Resend.
DEMO_FROM_EMAIL=REVORA <demos@your-verified-domain.example>
# Generate a random secret with: openssl rand -hex 32
DEMO_RATE_SALT=replace-with-at-least-32-random-characters
